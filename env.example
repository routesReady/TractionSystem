PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/traction_operation
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
UPLOAD_PASSWORD=CHANGE_THIS_UPLOAD_PASSWORD
CLIENT_ORIGIN=https://trokotakavach.com
FRONTEND_URL=https://www.trokotakavach.com

# Required for Admin login
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# Optional SMS (Twilio). If omitted, password reset still completes but SMS is marked not_configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NODE_ENV=development

# SMTP for password-reset confirmation emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mujahatalikhan@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=mujahatalikhan@gmail.com

# Optional stability/performance tuning (defaults are applied when omitted)
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=1
MONGO_MAX_IDLE_TIME_MS=60000
HTTP_REQUEST_TIMEOUT_MS=120000
SLOW_API_LOG_MS=1500
